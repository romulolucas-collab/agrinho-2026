<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agro Futuro</title>

<style>
body{
    margin:0;
    font-family:Verdana, sans-serif;
    background:#eef7ee;
}

header{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:30px;
}

menu{
    display:flex;
    justify-content:center;
    background:#1f6b42;
    padding:12px;
}

menu a{
    color:white;
    text-decoration:none;
    margin:0 20px;
    font-weight:bold;
}

menu a:hover{
    color:#c8ffb0;
}

section{
    padding:30px;
}

.card{
    background:white;
    padding:20px;
    margin:15px 0;
    border-left:5px solid green;
    border-radius:8px;
    box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

button{
    background:green;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:darkgreen;
}

#resultado{
    margin-top:15px;
    font-weight:bold;
    color:green;
}

footer{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
</style>

</head>
<body>

<header>
    <h1>🌾 Agro Futuro</h1>
    <p>Inovação e tecnologia para o campo</p>
</header>

<menu>
    <a href="#inicio">Início</a>
    <a href="#beneficios">Benefícios</a>
    <a href="#contato">Contato</a>
</menu>

<section id="inicio">
    <h2>Bem-vindo ao Agro Futuro</h2>

    <div class="card">
        <p>
            O agronegócio moderno utiliza tecnologia para aumentar a produção,
            reduzir desperdícios e preservar os recursos naturais.
        </p>
    </div>
</section>

<section id="beneficios">
    <h2>Principais Benefícios</h2>

    <div class="card">
        🚜 Máquinas agrícolas inteligentes
    </div>

    <div class="card">
        🚁 Uso de drones para monitoramento
    </div>

    <div class="card">
        🌱 Produção sustentável
    </div>

    <div class="card">
        📊 Análise de dados para melhorar colheitas
    </div>
</section>

<section id="contato">
    <h2>Interação</h2>

    <p>Clique no botão para conhecer uma vantagem do Novo Agro:</p>

    <button onclick="mostrarMensagem()">
        Mostrar Vantagem
    </button>

    <div id="resultado"></div>
</section>

<footer>
    <p>© 2026 Agro Futuro</p>
</footer>

<script>
function mostrarMensagem() {

    const vantagens = [
        "Maior produtividade nas lavouras.",
        "Economia de água e recursos.",
        "Uso de tecnologia avançada no campo.",
        "Melhor qualidade dos produtos agrícolas.",
        "Redução dos impactos ambientais."
    ];

    let numero = Math.floor(Math.random() * vantagens.length);

    document.getElementById("resultado").innerHTML =
        vantagens[numero];
}
</script>

</body>
</html>
