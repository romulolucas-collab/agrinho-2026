<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agro Futuro</title>

<style>

/* =========================
   ESTILO GERAL
========================= */

body{
    margin:0;
    font-family:Verdana, sans-serif;
    background:#eef7ee;
    transition:0.3s;
}

/* =========================
   BOTÃO DE TEMA (FIXO)
========================= */

#temaBtn{
    position:fixed;
    top:15px;
    right:15px;
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    background:white;
    color:black;
    font-weight:bold;
    z-index:1000;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

/* =========================
   CABEÇALHO
========================= */

header{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:30px;
}

/* =========================
   MENU
========================= */

nav{
    background:#1f6b42;
    text-align:center;
    padding:12px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 20px;
    font-weight:bold;
}

nav a:hover{
    color:#c8ffb0;
}

/* =========================
   CONTEÚDO
========================= */

section{
    padding:30px;
}

/* CARD */
.card{
    background:white;
    padding:20px;
    margin:15px 0;
    border-left:5px solid green;
    border-radius:8px;
    box-shadow:0 2px 5px rgba(0,0,0,0.1);
}

/* =========================
   INTERAÇÃO
========================= */

.interacao{
    text-align:center;
}

button{
    background:green;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:5px;
    cursor:pointer;
    font-size:16px;
    transition:0.2s;
}

button:hover{
    background:darkgreen;
}

#resultado{
    margin-top:15px;
    font-weight:bold;
    color:green;
    font-size:18px;
}

/* =========================
   RODAPÉ
========================= */

footer{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* =========================
   MODO ESCURO
========================= */

.dark-mode{
    background:#121212;
    color:white;
}

.dark-mode .card{
    background:#1e1e1e;
    color:white;
    border-left:5px solid #4CAF50;
}

.dark-mode nav{
    background:#111;
}

.dark-mode header{
    background:#0a5c2d;
}

.dark-mode footer{
    background:#0a5c2d;
}

.dark-mode #resultado{
    color:#90ee90;
}

</style>
</head>

<body>

<!-- BOTÃO FIXO -->
<button id="temaBtn" onclick="alternarTema()">
    🌙 Modo Escuro
</button>

<!-- CABEÇALHO -->
<header>
    <h1>🌾 Agro Futuro</h1>
    <p>Inovação e tecnologia para o campo</p>
</header>

<!-- MENU -->
<nav>
    <a href="#inicio">Início</a>
    <a href="#beneficios">Benefícios</a>
    <a href="#vantagens">Vantagens</a>
</nav>

<!-- INÍCIO -->
<section id="inicio">
    <h2>Bem-vindo ao Agro Futuro</h2>

    <div class="card">
        <p>
            O Novo Agro utiliza tecnologia, inovação e sustentabilidade
            para melhorar a produção agrícola e preservar o meio ambiente.
        </p>
    </div>
</section>

<!-- BENEFÍCIOS -->
<section id="beneficios">
    <h2>Principais Benefícios</h2>

    <div class="card">🚜 Máquinas agrícolas inteligentes</div>
    <div class="card">🚁 Uso de drones para monitoramento</div>
    <div class="card">🌱 Produção sustentável</div>
    <div class="card">📊 Análise de dados para melhorar as colheitas</div>
</section>

<!-- INTERAÇÃO -->
<section id="vantagens" class="interacao">
    <h2>Descubra uma Vantagem</h2>

    <p>Clique no botão abaixo:</p>

    <button onclick="mostrarMensagem()">
        Mostrar Vantagem
    </button>

    <div id="resultado"></div>
</section>

<!-- RODAPÉ -->
<footer>
    <p>© 2026 Agro Futuro - O Novo Agro</p>
</footer>

<script>

/* =========================
   MODO ESCURO
========================= */

window.onload = function(){

    const temaSalvo = localStorage.getItem("tema");

    if(temaSalvo === "escuro"){
        document.body.classList.add("dark-mode");
        document.getElementById("temaBtn").innerHTML = "☀️ Modo Claro";
    }
}

/* ALTERAR TEMA */
function alternarTema(){

    document.body.classList.toggle("dark-mode");

    const botao = document.getElementById("temaBtn");

    if(document.body.classList.contains("dark-mode")){
        botao.innerHTML = "☀️ Modo Claro";
        localStorage.setItem("tema","escuro");
    }else{
        botao.innerHTML = "🌙 Modo Escuro";
        localStorage.setItem("tema","claro");
    }
}

/* VANTAGENS ALEATÓRIAS */
function mostrarMensagem(){

    const vantagens = [
        "🌾 Maior produtividade nas lavouras.",
        "💧 Economia de água e recursos.",
        "🚜 Mais eficiência com máquinas modernas.",
        "📈 Melhor planejamento da produção.",
        "🌱 Menor impacto ambiental.",
        "🚁 Monitoramento rápido com drones."
    ];

    const numero = Math.floor(Math.random() * vantagens.length);

    document.getElementById("resultado").innerHTML =
        vantagens[numero];
}

</script>

</body>
</html>
