<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Agro Futuro</title>

<style>

body{
    margin:0;
    font-family:Verdana, sans-serif;
    background:#eef7ee;
}

#site{
    transition:0.3s;
}

/* BOTÕES FIXOS */
#temaBtn, #deviceBtn{
    position:fixed;
    right:15px;
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
    z-index:1000;
    background:white;
    box-shadow:0 2px 8px rgba(0,0,0,0.2);
}

/* posições */
#temaBtn{ top:15px; }
#deviceBtn{ top:65px; }

/* HEADER */
header{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:30px;
}

/* MENU */
nav{
    background:#1f6b42;
    text-align:center;
    padding:12px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 20px;
    font-weight:bold;
}

/* SEÇÕES */
section{
    padding:30px;
}

/* CARD */
.card{
    background:white;
    padding:20px;
    margin:15px 0;
    border-left:5px solid green;
    border-radius:8px;
}

/* BOTÃO NORMAL */
button{
    background:green;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:5px;
    cursor:pointer;
}

/* RESULTADO */
#resultado{
    margin-top:15px;
    font-weight:bold;
    color:green;
}

/* FOOTER */
footer{
    background:#2e8b57;
    color:white;
    text-align:center;
    padding:15px;
}

/* DARK MODE */
.dark-mode{
    background:#121212;
    color:white;
}

.dark-mode .card{
    background:#1e1e1e;
    color:white;
}

.dark-mode nav,
.dark-mode header,
.dark-mode footer{
    background:#0a5c2d;
}

</style>
</head>

<body>

<!-- BOTÕES COM NOMES CLAROS -->
<button id="temaBtn" onclick="alternarTema()">
    Tema: Claro
</button>

<button id="deviceBtn" onclick="trocarDispositivo()">
    Dispositivo: Celular
</button>

<div id="site">

<header>
    <h1>🌾 Agro Futuro</h1>
    <p>Inovação e tecnologia para o campo</p>
</header>

<nav>
    <a href="#inicio">Início</a>
    <a href="#beneficios">Benefícios</a>
    <a href="#vantagens">Vantagens</a>
</nav>

<section id="inicio">
    <h2>Bem-vindo ao Agro Futuro</h2>

    <div class="card">
        <p>
            O Novo Agro utiliza tecnologia, inovação e sustentabilidade
            para melhorar a produção agrícola.
        </p>
    </div>
</section>

<section id="beneficios">

    <h2>Benefícios</h2>

    <div class="card">🚜 Máquinas inteligentes</div>
    <div class="card">🚁 Drones agrícolas</div>
    <div class="card">🌱 Sustentabilidade</div>

</section>

<section id="vantagens">

    <h2>Descubra uma Vantagem</h2>

    <button onclick="mostrarMensagem()">Mostrar Vantagem</button>

    <div id="resultado"></div>

</section>

<footer>
    <p>© 2026 Agro Futuro</p>
</footer>

</div>

<script>

/* TEMA */
function alternarTema(){

    document.body.classList.toggle("dark-mode");

    const btn = document.getElementById("temaBtn");

    if(document.body.classList.contains("dark-mode")){
        btn.innerHTML = "Tema: Escuro";
        localStorage.setItem("tema","escuro");
    }else{
        btn.innerHTML = "Tema: Claro";
        localStorage.setItem("tema","claro");
    }
}

/* carregar tema salvo */
window.onload = function(){

    const tema = localStorage.getItem("tema");

    const btn = document.getElementById("temaBtn");

    if(tema === "escuro"){
        document.body.classList.add("dark-mode");
        btn.innerHTML = "Tema: Escuro";
    }else{
        btn.innerHTML = "Tema: Claro";
    }
}

/* DISPOSITIVO */
let modo = "celular";

function trocarDispositivo(){

    const site = document.getElementById("site");
    const btn = document.getElementById("deviceBtn");

    if(modo === "celular"){
        site.style.transform = "scale(0.75)";
        btn.innerHTML = "Dispositivo: Tablet";
        modo = "tablet";

    }else if(modo === "tablet"){
        site.style.transform = "scale(1)";
        btn.innerHTML = "Dispositivo: Computador";
        modo = "pc";

    }else{
        site.style.transform = "scale(1.1)";
        btn.innerHTML = "Dispositivo: Celular";
        modo = "celular";
    }
}

/* VANTAGENS */
function mostrarMensagem(){

    const vantagens = [
        "🌾 Maior produtividade",
        "💧 Economia de água",
        "🚜 Máquinas modernas",
        "📈 Melhor planejamento",
        "🌱 Sustentabilidade",
        "🚁 Drones no campo"
    ];

    const i = Math.floor(Math.random() * vantagens.length);

    document.getElementById("resultado").innerHTML = vantagens[i];
}

</script>

</body>
</html>
